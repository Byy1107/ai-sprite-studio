{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sprite-studio.local/schemas/spritesheet-v1.schema.json",
  "title": "AI Sprite Studio spritesheet metadata v1",
  "type": "object",
  "required": ["meta", "animations"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["app", "schema_version", "image", "size", "scale", "spacing", "padding"],
      "additionalProperties": false,
      "properties": {
        "app": {"const": "AI Sprite Studio"},
        "schema_version": {"const": 1},
        "image": {"const": "sprite.png"},
        "size": {"$ref": "#/$defs/positiveSize"},
        "scale": {"enum": [1, 2, 4, 8]},
        "spacing": {"type": "integer", "minimum": 0},
        "padding": {"type": "integer", "minimum": 0},
        "preset_id": {"const": "godot4"}
      }
    },
    "animations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/animation"}
    }
  },
  "$defs": {
    "positiveSize": {
      "type": "object",
      "required": ["w", "h"],
      "additionalProperties": false,
      "properties": {
        "w": {"type": "integer", "minimum": 1},
        "h": {"type": "integer", "minimum": 1}
      }
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": {"type": "integer"},
        "y": {"type": "integer"}
      }
    },
    "rect": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "w": {"type": "integer", "minimum": 1},
        "h": {"type": "integer", "minimum": 1}
      }
    },
    "frame": {
      "type": "object",
      "required": ["asset_version_id", "rect", "duration_ms", "pivot", "offset", "events"],
      "additionalProperties": false,
      "properties": {
        "asset_version_id": {"type": "string", "minLength": 1},
        "rect": {"$ref": "#/$defs/rect"},
        "duration_ms": {"type": "integer", "minimum": 1},
        "pivot": {"$ref": "#/$defs/point"},
        "offset": {"$ref": "#/$defs/point"},
        "events": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "animation": {
      "type": "object",
      "required": ["name", "direction", "fps", "loop_mode", "frames"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "direction": {"type": "string", "minLength": 1},
        "fps": {"type": "integer", "minimum": 1},
        "loop_mode": {"enum": ["loop", "once", "ping_pong"]},
        "frames": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/frame"}}
      }
    }
  }
}
